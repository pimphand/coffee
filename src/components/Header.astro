---
// Single reusable site header. No variant prop.
// All pages (home / about / blog / etc.) render the same markup so the
// brand is visually consistent across the site.
// - Desktop brand logo  → white-on-dark circular logo (coffee theme).
// - Mobile off-canvas   → dark logo so it stays readable on the white
//                         mobile-menu background.
// - Language switcher  → Live on the right; lets users flip between
//                         Indonesian (default) and English (/en/).
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n/utils';

const headerClass = 'header-area header-two transparent-header';
const logoWhite   = '/assets/images/home-coffee/logo/logo-white.webp';
const logoMobile  = '/assets/images/home-coffee/logo/logo-main.webp';
const t = useTranslations(Astro.currentLocale);
---
<style is:global>
  /* Force brand logo to a 60×60 circle on every page, regardless of
     which page-specific CSS file is loaded (home-coffee.css vs
     innerpages.css). Single source of truth. */
  .site-branding .brand-logo img {
    height: 60px;
    width: 60px;
    object-fit: cover;
    border-radius: 50%;
  }
</style>

<header class={headerClass}>
  <div class="container">
    <div class="header-navigation">
      <div class="nav-inner-menu">
        <div class="primary-menu">
          <!-- Site Branding -->
          <div class="site-branding">
            <a href="/" class="brand-logo"><img src={logoWhite} alt="Brew Haven Logo"></a>
          </div>
          <!-- Theme Main Menu -->
          <div class="theme-nav-menu">
            <!-- Mobile Menu Top -->
            <div class="theme-menu-top d-flex justify-content-between d-block d-lg-none mb-4">
              <div class="site-branding">
                <a href="/" class="brand-logo"><img src={logoMobile} alt="Brew Haven Logo"></a>
              </div>
              <div class="navbar-close">
                <i class="far fa-times"></i>
              </div>
            </div>
            <!-- Main Menu -->
            <nav class="main-menu">
              <ul>
                <li class="menu-item"><a href="/">{t('nav.home')}</a></li>
                <li class="menu-item"><a href="/about">{t('nav.about')}</a></li>
                <li class="menu-item"><a href="/menu">{t('nav.menu')}</a></li>
                <li class="menu-item"><a href="/team">{t('nav.team')}</a></li>
                <li class="menu-item"><a href="/blog">{t('nav.blog')}</a></li>
                <li class="menu-item"><a href="/contact">{t('nav.contact')}</a></li>
              </ul>
            </nav>
            <!-- Theme Nav Button (mobile CTA) -->
            <div class="theme-nav-button mt-3 d-block d-md-none">
              <button type="button" class="theme-btn style-one border-0" data-bs-toggle="modal" data-bs-target="#reservationModal">{t('btn.reservation')}</button>
            </div>
            <!-- Theme Menu Bottom (mobile social) -->
            <div class="theme-menu-bottom mt-5 d-block d-lg-none">
              <h5>Follow Us</h5>
              <ul class="social-link">
                <li><a href="#"><i class="fab fa-facebook-f"></i></a></li>
                <li><a href="#"><i class="fab fa-twitter"></i></a></li>
                <li><a href="#"><i class="fab fa-linkedin-in"></i></a></li>
                <li><a href="#"><i class="fab fa-youtube"></i></a></li>
              </ul>
            </div>
          </div>
          <!-- Header Nav Right -->
          <div class="nav-right-item">
            <LanguageSwitcher />
            <div class="nav-button d-none d-md-block">
              <button type="button" class="theme-btn style-one border-0" data-bs-toggle="modal" data-bs-target="#reservationModal">{t('btn.reservation')}</button>
            </div>
            <div class="navbar-toggler">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
