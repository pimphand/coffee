# Brew Haven env file template — copy to `.env` and fill in real values.
# ANY of these missing means the build will fall back to hardcoded data
# inside src/data/* instead of failing.

# Direct Postgres connection string (the password is YOUR_PASSWORD placeholder;
# replace with the real one from Supabase Project Settings → Database).
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.zqpyrmpqqeezmlnqxoqn.supabase.co:5432/postgres

# 32+ char random secret used to sign session cookies. Generate via:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=please-replace-with-long-random-hex

# Optional: log SQL queries during dev. Leave unset in prod.
# DEBUG_SQL=1
