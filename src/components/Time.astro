---
// Opening time + Map section with reservation CTA.
// Data sourced from DB settings (editable via /admin/settings).
import { Settings } from '../lib/db';

const settings = await Settings.get();

const defaultHours = [
  { day: 'Monday',    hours: '10:00AM - 07:00PM', close: false },
  { day: 'Tuesday',   hours: '10:00AM - 06:00PM', close: false },
  { day: 'Wednesday', hours: '10:00AM - 06:30PM', close: false },
  { day: 'Thursday',  hours: '10:00AM - 07:00PM', close: false },
  { day: 'Friday',    hours: '10:00AM - 06:00PM', close: false },
  { day: 'Saturday',  hours: '10:00AM - 06:30PM', close: false },
  { day: 'Sunday',    hours: 'Closed',            close: true  },
];

interface OpeningDay { day: string; hours: string; close: boolean }
const openingHours: OpeningDay[] = (Array.isArray(settings?.opening_time) && settings!.opening_time.length > 0)
  ? settings!.opening_time as unknown as OpeningDay[]
  : defaultHours;

const mapsSrc = settings?.google_maps_iframe
  || 'https://maps.google.com/maps?q=new%20york&amp;t=&amp;z=13&amp;ie=UTF8&amp;iwloc=&amp;output=embed';
---
<section class="cs-time-sec py-5" id="contact">
  <div class="container">
    <div class="row py-5 justify-content-center">
      <div class="col-xl-6 col-lg-8 col-md-10">
        <div class="bistly-content-box text-white mt-4 mb-4 text-center text-xl-start">
          <div class="section-title mb-4" data-aos="fade-up" data-aos-duration="1000">
            <h2 class="text-anm">Join Us During These Opening Time</h2>
          </div>
          <p class="mb-4" data-aos="fade-up" data-aos-duration="1200">Join us during our opening hours for a memorable dining experience filled with delicious food, warm ambiance, and friendly service.</p>
          <div class="bistly-button" data-aos="fade-up" data-aos-duration="1400">
            <a href="/contact" class="theme-btn style-two">Contact Us</a>
          </div>
        </div>
        <!--=== Map Box ===-->
        <div class="map-box mb-5" data-aos="fade-up" data-aos-duration="1600">
          <iframe src={mapsSrc}></iframe>
        </div>
      </div>
      <div class="col-xl-6 col-lg-8 col-md-10">
        <div class="opening-time-box mt-4 mb-4" data-aos="fade-up" data-aos-duration="1900">
          <h3>Opening Time</h3>
          <ul>
            {openingHours.map((row) => (
              <li>
                {row.day} <span class={row.close ? 'close' : ''}>{row.hours}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
