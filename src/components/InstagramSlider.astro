---
// Instagram image slider (slick carousel), reused at the bottom of
// blog list, blog detail, and about pages.
// All default photos are real Brew Haven coffee shots from home-coffee/,
// with 6 distinct images (no artificial duplicates) for a smoother feed.
const defaultImages = [
  '/assets/images/home-coffee/about/about-img1.jpg',        // barista latte art
  '/assets/images/home-coffee/blog/blog-img1.jpg',          // roasted coffee beans
  '/assets/images/home-coffee/gallery/enjoy-img1.png',      // craft coffee art
  '/assets/images/home-coffee/gallery/enjoy-img2.png',      // cappuccino
  '/assets/images/home-coffee/gallery/cup.png',             // rose latte art
  '/assets/images/home-coffee/menu/menu-thumb3.png'         // cappuccino top-down
];
interface Props {
  images?: string[];
}
const { images = defaultImages } = Astro.props;
---
<style is:global>
  /* Instagram carousel — force every tile to a uniform 1:1 square
     so all photos render at the same size regardless of source
     aspect ratio. Slick shows 5 tiles per row by default, so all
     5 must share identical height or the row looks uneven.
     .thumbnail already has overflow:hidden from innerpage.css. */
  .bistly-instagram-sec .bistly-instagram-item .thumbnail {
    aspect-ratio: 1 / 1;
  }
  .bistly-instagram-sec .bistly-instagram-item .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<section class="bistly-instagram-sec">
  <div class="instagram-slider">
    {images.map((src) => (
      <div class="bistly-instagram-item">
        <div class="thumbnail">
          <img src={src} alt="Brew Haven Instagram">
          <div class="hover-content">
            <div class="icon">
              <i class="fab fa-instagram"></i>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
