---
// Hero section with background image, hero title, animated text, and video play button.
---
<section class="cs-hero-sec bg_cover p-r z-1" style="background-image: url(/assets/images/home-coffee/hero/hero-bg.jpg);">
  <!-- Play Button -->
  <div class="play-button">
    <a href="https://www.youtube.com/watch?v=Fjf20HmHRd8" class="video-popup"><i class="fas fa-play"></i></a>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Hero Content -->
        <div class="hero-content">
          <h1 class="text-anm">Every Sip Fresh</h1>
          <div class="text-box" data-aos="fade-left" data-aos-duration="1500">
            <p>Experience the perfect brew in every cup Rich aroma, smooth taste, &amp; unmatched freshness—crafted to awaken you.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
