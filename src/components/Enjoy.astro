---
// "Enjoy Coffee" black-background section with two floating background images.
---
<section class="cs-enjoy-coffee py-5 p-r z-1 overflow-hidden">
  <div class="bistly-image image_one"><img src="/assets/images/home-coffee/gallery/enjoy-img1.webp" alt="Coffee art"></div>
  <div class="bistly-image image_two"><img src="/assets/images/home-coffee/gallery/enjoy-img2.webp" alt="Latte art"></div>
  <div class="container py-5">
    <div class="row justify-content-center py-5">
      <div class="col-xl-6 col-lg-8">
        <!-- Bistly Content Box -->
        <div class="bistly-content-box text-center py-5 px-md-5">
          <div class="section-title">
            <h2 class="text-anm">Enjoy Coffee</h2>
          </div>
          <p data-aos="fade-up" data-aos-duration="1000">At Brew Haven, coffee is more than a drink it's a ritual. Since 2015, we've blended quality beans, community vibes &amp; expert brewing to serve moments that matter.</p>
        </div>
      </div>
    </div>
  </div>
</section>
