---
import Layout      from '../../layouts/Layout.astro';
import Preloader   from '../../components/Preloader.astro';
import Header      from '../../components/Header.astro';
import Footer      from '../../components/Footer.astro';
import PageBanner  from '../../components/PageBanner.astro';
---
<Layout title="Contact Us - Brew Haven" description="Reach Brew Haven" pageStyle="inner">
  <Preloader /><Header />
  <div id="smooth-wrapper"><div id="smooth-content"><main>
    <PageBanner title="Contact Us" breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]} />
    <section class="contact-info-sec py-5 mt-xl-4"><div class="container"><div class="row py-5">
      <div class="col-lg-4 col-md-6 col-sm-12"><div class="contact-info-box text-center mb-4" data-aos="fade-up" data-aos-duration="800"><div class="icon"><i class="far fa-map-marker-alt"></i></div><div class="content"><h3>Our Location</h3><p>456 Elm Avenue, Metropolis NY 10001</p></div></div></div>
      <div class="col-lg-4 col-md-6 col-sm-12"><div class="contact-info-box text-center mb-4" data-aos="fade-up" data-aos-duration="1000"><div class="icon"><i class="far fa-phone-alt"></i></div><div class="content"><h3>Contact Number</h3><p><a href="tel:+0001234567890">+000 123 456 7890</a></p></div></div></div>
      <div class="col-lg-4 col-md-6 col-sm-12"><div class="contact-info-box text-center mb-4" data-aos="fade-up" data-aos-duration="1200"><div class="icon"><i class="far fa-envelope"></i></div><div class="content"><h3>Email Address</h3><p><a href="mailto:contact@brewhaven.example">contact@brewhaven.example</a></p></div></div></div>
    </div></div></section>
    <section class="bistly-contact-sec pb-5"><div class="container"><div class="row pb-3 justify-content-center">
      <div class="col-xl-6 col-lg-8"><div class="bistly-content-box pe-xl-5"><div class="section-title"><span class="sub-title" data-aos="fade-down" data-aos-duration="1000">Contact Us</span><h2 class="text-anm">Talk to Us Today</h2></div><p data-aos="fade-up" data-aos-duration="1200">Have a question? Reach out to our friendly team anytime.</p></div></div>
      <div class="col-xl-6 col-lg-8"><div class="contact-wrapper mt-xl-0 mt-5" data-aos="fade-up" data-aos-duration="1400"><form><div class="row">
        <div class="col-lg-12"><div class="form-group"><label>Full Name</label><input type="text" class="form_control" placeholder="Enter full name" required></div></div>
        <div class="col-lg-6"><div class="form-group"><label>Email</label><input type="email" class="form_control" placeholder="Enter email" required></div></div>
        <div class="col-lg-6"><div class="form-group"><label>Phone</label><input type="tel" class="form_control" placeholder="Enter phone number" required></div></div>
        <div class="col-lg-12"><div class="form-group"><label>Message</label><textarea class="form_control" rows="4" placeholder="Writing message..."></textarea></div></div>
        <div class="col-lg-12"><div class="form-group"><button class="theme-btn style-one" type="submit">Submit Request</button></div></div>
      </div></form></div></div>
    </div></div></section>
    <section class="map-sec"><div class="map-box mt-5 pt-3" data-aos="fade-up" data-aos-duration="1200"><iframe src="https://www.google.com/maps/embed?pb=!1m10!1m8!1m3!1d96777.16150026117!2d-74.00840582560909!3d40.71171357405996!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sbd!4v1706508986625!5m2!1sen!2sbd" loading="lazy" title="Brew Haven location"></iframe></div></section>
  </main><Footer /></div></div>
</Layout>
