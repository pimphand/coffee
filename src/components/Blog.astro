---
// Latest 3 blog posts preview — fetched from DB with fallback.
import { BlogPosts } from '../lib/db';
import { posts as fallbackPosts } from '../data/posts';

const dbPosts = await BlogPosts.list(3);
const posts = dbPosts.length > 0
  ? dbPosts.map((p) => ({
      img: p.image,
      title: p.title_en,
      excerpt: p.excerpt_en,
      author: `By ${p.author_name}`,
      date: new Date(p.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    }))
  : fallbackPosts.slice(0, 3).map((p) => ({
      img: p.image,
      title: p.title,
      excerpt: p.excerpt,
      author: `By ${p.author}`,
      date: p.date,
    }));
---
<section class="cs-blog-sec py-5" id="blog">
  <div class="container">
    <div class="row py-5">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title text-center pt-4 mb-4">
          <h2 class="text-anm">Our Latest Blog Post</h2>
        </div>
      </div>
    </div>
    <div class="row justify-content-center pb-5">
      {posts.map((post, idx) => (
        <div class="col-xl-4 col-md-6 col-sm-12">
          <div class="bistly-blog-post mb-4" data-aos="fade-up" data-aos-duration={1000 + idx * 300}>
            <div class="post-thumbnail">
              <img src={post.img} alt={post.title}>
            </div>
            <div class="post-content">
              <div class="post-meta">
                <span><i class="far fa-user"></i>{post.author}</span>
                <span><i class="far fa-calendar-alt"></i>{post.date}</span>
              </div>
              <h4><a href="#blog-details">{post.title}</a></h4>
              <p>{post.excerpt} <a href="#blog-details">Read More</a></p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
