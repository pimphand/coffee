[TEMPLATE]
# Brew Haven env file template — copy to `.env` and fill in real values.
# ANY of these missing means the build will fall back to hardcoded data
# inside src/data/* instead of failing.

# ── Cloudflare D1 (pengganti Supabase Postgres) ─────────────────────
# Database tidak diakses lewat URL — aplikasi memakai binding D1 "DB"
# yang didefinisikan di wrangler.jsonc. Untuk membuat database:
#   npx wrangler d1 create bistly-coffee
# lalu salin database_id-nya ke wrangler.jsonc.
#
# Setup lokal & produksi ada di README.md:
#   npm run db:migrate       # skema ke D1 lokal
#   npm run db:migrate:remote  # skema ke D1 produksi

# 32+ char random secret used to sign session cookies. Generate via:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Di Cloudflare, set ini sebagai secret (bukan .env):
#   npx wrangler secret put SESSION_SECRET      (produksi)
#   tulis SESSION_SECRET=... di .dev.vars        (development lokal)
SESSION_SECRET=please-replace-with-long-random-hex

# ── Hanya untuk skrip sekali-pakai db:import ───────────────────────
# Koneksi Postgres LAMA (mis. Supabase) yang datanya mau dipindah ke D1:
#   npm run db:import  →  db/export/d1-import.sql
# SOURCE_DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Optional: log SQL queries during dev. Leave unset in prod.
# DEBUG_SQL=1
