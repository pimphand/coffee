---
// Language switcher — renders links for all locales other than the
// current one. Supports en (default), id, and cn.
import { supportedLocales, defaultLang, getLocalizedPath } from '../i18n/utils';

const currentLocale = (Astro.currentLocale ?? defaultLang) as 'en' | 'id' | 'cn';
const others = supportedLocales.filter((l) => l !== currentLocale);
const currentPath = Astro.url.pathname;
---

<div class="lang-switch" aria-label="Language switcher">
  {others.map((l) => (
    <a
      href={getLocalizedPath(currentPath, l)}
      class="lang-link"
      data-lang={l}
      aria-label={`Switch language to ${l === 'cn' ? 'Chinese' : l.toUpperCase()}`}
    >
      {l === 'cn' ? '中文' : l.toUpperCase()}
    </a>
  ))}
</div>

<style is:global>
  /* Inline language toggle — visual styling matches the small header
     controls (Reservation button height ~). Hover fades to brand gold
     to match the rest of the nav UI. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 12px;
  }
  .lang-switch .lang-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 6px 11px;
    border: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 4px;
    transition: color 0.25s, border-color 0.25s, background-color 0.25s;
    line-height: 1;
  }
  .lang-switch .lang-link:hover {
    color: #c8a97e;
    border-color: #c8a97e;
    background-color: rgba(200, 169, 126, 0.08);
  }
</style>
