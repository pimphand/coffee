---
// Menu section with Coffee (5 items) on the left and Juice/Snack on the right.
const coffeeItems = [
  { thumb: '/assets/images/home-coffee/menu/menu-thumb1.webp', title: 'Americano',      desc: 'Espresso diluted with hot water, resulting in a smoother taste.',                       price: '$21.99' },
  { thumb: '/assets/images/home-coffee/menu/menu-thumb2.webp', title: 'Espresso',        desc: 'A strong, concentrated coffee shot, the base for many coffee drinks.',                  price: '$27.99' },
  { thumb: '/assets/images/home-coffee/menu/menu-thumb3.webp', title: 'Cappuccino',      desc: 'Equal parts espresso, steamed milk, and milk foam. Rich and frothy.',                   price: '$32.99' },
  { thumb: '/assets/images/home-coffee/menu/menu-thumb4.webp', title: 'Flat White',      desc: 'Similar to latte but with a higher espresso-to-milk ratio and a velvety texture.',       price: '$18.99' },
  { thumb: '/assets/images/home-coffee/menu/menu-thumb5.webp', title: 'Macchiato',       desc: "Espresso \"stained\" with a small amount of milk or milk foam.",                          price: '$23.99' }
];

const juiceItems = [
  { thumb: '/assets/images/home-coffee/menu/menu-thumb6.webp', title: 'Chocolate Fudge Cake', desc: 'Rich, moist chocolate layers with creamy ganache.',         price: '$15.99' },
  { thumb: '/assets/images/home-coffee/menu/menu-thumb7.webp', title: 'Cinnamon Roll',       desc: 'Soft dough swirled with cinnamon and topped with icing.',  price: '$19.99' }
];

const snackItems = [
  { thumb: '/assets/images/home-coffee/menu/menu-thumb8.webp', title: 'French Fries',    desc: 'Golden, crispy French fries served hot with a touch of salt.',                  price: '$17.99' },
  { thumb: '/assets/images/home-coffee/menu/menu-thumb9.webp', title: 'Chicken Nuggets', desc: 'Crispy golden bites tender chicken perfect for dipping snacking anytime.', price: '$24.99' }
];
---
<section class="bistly-menu-sec bg_cover py-5 p-r z-1 overflow-hidden" id="menu"
         style="background-image: url(/assets/images/home-coffee/bg/menu-bg.webp);">
  <div class="container">
    <div class="row py-5">
      <div class="col-lg-12">
        <!-- Section Title -->
        <div class="section-title text-white text-center py-3">
          <h2 class="text-anm">Our Coffee Creations</h2>
        </div>
      </div>
    </div>
    <div class="row pb-5">
      <div class="col-lg-6">
        <!-- Coffee List -->
        <div class="menu-item-list item-left-list">
          <h3 class="title mb-4" data-aos="fade-up" data-aos-duration="800">Coffee</h3>
          {coffeeItems.map((item, idx) => (
            <div class="bistly-menu-item mb-4" data-aos="fade-up" data-aos-duration={1000 + idx * 200}>
              <div class="thumbnail">
                <img src={item.thumb} alt={`${item.title} thumbnail`}>
              </div>
              <div class="content-price-wrap">
                <div class="content">
                  <h4><a href="#menu-details">{item.title}</a></h4>
                  <p>{item.desc}</p>
                </div>
                <div class="price-wrap">
                  <div class="price">{item.price}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="col-lg-6">
        <!-- Juice List -->
        <div class="menu-item-list item-right-list">
          <h3 class="title mb-4" data-aos="fade-up" data-aos-duration="800">Juice</h3>
          {juiceItems.map((item, idx) => (
            <div class="bistly-menu-item mb-4" data-aos="fade-up" data-aos-duration={1000 + idx * 200}>
              <div class="thumbnail">
                <img src={item.thumb} alt={`${item.title} thumbnail`}>
              </div>
              <div class="content-price-wrap">
                <div class="content">
                  <h4><a href="#menu-details">{item.title}</a></h4>
                  <p>{item.desc}</p>
                </div>
                <div class="price-wrap">
                  <div class="price">{item.price}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <!-- Snack List -->
        <div class="menu-item-list item-right-list">
          <h3 class="title mb-4" data-aos="fade-up" data-aos-duration="800">Snack</h3>
          {snackItems.map((item, idx) => (
            <div class="bistly-menu-item mb-4" data-aos="fade-up" data-aos-duration={1000 + idx * 200}>
              <div class="thumbnail">
                <img src={item.thumb} alt={`${item.title} thumbnail`}>
              </div>
              <div class="content-price-wrap">
                <div class="content">
                  <h4><a href="#menu-details">{item.title}</a></h4>
                  <p>{item.desc}</p>
                </div>
                <div class="price-wrap">
                  <div class="price">{item.price}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
