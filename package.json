{
  "name": "bistly-coffee",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Brew Haven coffee theme — static marketing site + SSR admin dashboard backed by Cloudflare D1",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "types": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --file db/seeder/001_users.sql --local && wrangler d1 execute DB --file db/seeder/002_settings.sql --local",
    "db:seed:remote": "wrangler d1 execute DB --file db/seeder/001_users.sql --remote && wrangler d1 execute DB --file db/seeder/002_settings.sql --remote",
    "db:import": "node scripts/export-postgres-to-d1.js",
    "migrate": "wrangler d1 migrations apply DB --local",
    "seed": "wrangler d1 execute DB --file db/seeder/001_users.sql --local && wrangler d1 execute DB --file db/seeder/002_settings.sql --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/tailwind": "6.0.2",
    "@astrojs/vue": "7.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "astro": "7.3.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^0.460.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.6.2",
    "postgres": "^3.4.9",
    "typescript": "~5.7.0",
    "wrangler": "^4.83.0"
  }
}
